<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Redireciona requisições da API para o entrypoint do backend
    RewriteRule ^(api/.*)$ backend/public/index.php/$1 [L,QSA]
    
    # 2. Redireciona acessos diretos à pasta backend para o seu public
    RewriteCond %{REQUEST_URI} /backend/ [NC]
    RewriteRule ^backend/(.*)$ backend/public/$1 [L]
    
    # 3. Garante que o config.js do frontend seja servido corretamente, mesmo
    # se solicitado a partir de rotas aninhadas do React Router
    RewriteCond %{REQUEST_URI} !/frontend/dist/config\.js$ [NC]
    RewriteRule config\.js$ frontend/dist/config.js [L]

    # 4. Se a requisição NÃO contém frontend/dist/, api/ ou backend/ reescreve internamente para lá
    RewriteCond %{REQUEST_URI} !/frontend/dist/
    RewriteCond %{REQUEST_URI} !/backend/
    RewriteCond %{REQUEST_URI} !/api/
    RewriteRule ^(.*)$ frontend/dist/$1 [L]
    
    # 4. Tratamento para SPA (Vue/React Router):
    # Se o arquivo ou diretório físico não for encontrado dentro de frontend/dist,
    # faz o fallback para o index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ frontend/dist/index.html [L]
</IfModule>
