# URL base da API do backend (CodeIgniter).
#
# O Apache do XAMPP neste ambiente não tem um VirtualHost apontando para
# backend/public (DocumentRoot é D:\codes\xampp), então http://localhost/clinicas/
# NÃO chega no CodeIgniter. Use o servidor embutido do CodeIgniter:
#   cd backend && php spark serve --port 8080
# Se você configurar um VirtualHost/Alias apontando para backend/public,
# ajuste esta URL de acordo (e o cors.allowedOrigins no .env do backend
# continua valendo, não precisa mudar).
VITE_API_BASE_URL=http://localhost:8080/api/v1
