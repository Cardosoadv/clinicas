{
    "name": "clinicas/sistema-de-gestao-clinicas",
    "version": "1.0.3",
    "description": "Sistema de gestão para clínicas: agenda, prontuários, faturamento e relatórios financeiros. Desenvolvido em CodeIgniter 4 com padrão MVCRS.",
    "keywords": [
        "clinicas",
        "gestao",
        "codeigniter4",
        "php",
        "mvcrs"
    ],
    "license": "MIT",
    "type": "project",
    "support": {
        "source": "https://github.com/Cardosoadv/clinicas.git"
    },
    "require": {
        "php": "^8.1",
        "chillerlan/php-qrcode": "^6.0",
        "codeigniter4/framework": "^4.0",
        "codeigniter4/shield": "^1.2",
        "codeigniter4/translations": "^4.7",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php spark serve",
        "migrate": "php spark migrate",
        "migrate:rollback": "php spark migrate:rollback",
        "migrate:status": "php spark migrate:status",
        "routes": "php spark routes",
        "cache:clear": "php spark cache:clear"
    }
}
